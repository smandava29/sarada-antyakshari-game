{
  "name": "saradaga-antyakshari",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ads": "vite --mode ads-test",
    "build": "npm run build:development",
    "build:development": "tsc -b && node scripts/build-environment.js development",
    "build:production": "tsc -b && node scripts/build-environment.js production",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint .",
    "security:scan": "node scripts/security-scan.js",
    "verify": "npm run security:scan && npm run typecheck && npm run lint && npm test && npm run build",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.128.0"
  }
}
